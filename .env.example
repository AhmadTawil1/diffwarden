# Copy to .env and fill in. Never commit .env.

# --- Anthropic (needed now) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub App (fill in at Task 1.4, after creating the app) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=     # base64 -w0 private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- Review tuning (defaults are fine) ---
MIN_CONFIDENCE=0.7
MAX_COMMENTS=15
VERIFY_FINDINGS=true
