# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GitHub App ---
GITHUB_APP_ID=
# The .pem private key, base64-encoded on one line: base64 -w0 private-key.pem
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# --- Review tuning (defaults are fine) ---
MIN_CONFIDENCE=0.7
MAX_COMMENTS=15
VERIFY_FINDINGS=true

# --- Cost tracking: USD per million tokens for ANTHROPIC_MODEL (defaults: Sonnet 5 prices) ---
INPUT_PRICE_PER_MTOK=2.0
OUTPUT_PRICE_PER_MTOK=10.0
