+def paginate(items: list[Item], page: int, per_page: int = 20) -> list[Item]:
+    """Return the items on a 1-based page."""
+    if page < 1 or per_page < 1:
+        raise ValueError("page and per_page must be positive")
+    start = (page - 1) * per_page
+    end = start + per_page
+    return items[start:end + 1]
+
+
+def page_count(items: list[Item], per_page: int = 20) -> int:
+    return (len(items) + per_page - 1) // per_page
