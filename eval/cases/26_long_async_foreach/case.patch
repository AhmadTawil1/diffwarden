+"use strict";
+
+const db = require("./db");
+const payments = require("./payments");
+const mailer = require("./mailer");
+const log = require("./log");
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const TRIAL_DAYS = 14;
+const GRACE_DAYS = 3;
+const PERIOD_DAYS = 30;
+
+const PLANS = {
+  starter: { name: "Starter", monthlyCents: 900, seats: 3 },
+  team: { name: "Team", monthlyCents: 2900, seats: 10 },
+  business: { name: "Business", monthlyCents: 9900, seats: 50 },
+};
+
+class SubscriptionError extends Error {}
+
+function getPlan(planId) {
+  if (!Object.hasOwn(PLANS, planId)) {
+    throw new SubscriptionError(`unknown plan: ${planId}`);
+  }
+  return PLANS[planId];
+}
+
+function addDays(date, days) {
+  return new Date(date.getTime() + days * DAY_MS);
+}
+
+function daysBetween(from, to) {
+  return Math.ceil((to.getTime() - from.getTime()) / DAY_MS);
+}
+
+function formatPrice(cents) {
+  return `$${(cents / 100).toFixed(2)}`;
+}
+
+function isInTrial(sub, now = new Date()) {
+  return sub.trial_ends_at !== null && now < new Date(sub.trial_ends_at);
+}
+
+function graceExpired(sub, now = new Date()) {
+  return sub.status === "past_due" && now >= addDays(new Date(sub.past_due_since), GRACE_DAYS);
+}
+
+function prorateCents(fromPlan, toPlan, daysLeft, daysInPeriod) {
+  if (daysInPeriod <= 0) {
+    throw new SubscriptionError("period must be at least one day");
+  }
+  const clampedDays = Math.min(Math.max(daysLeft, 0), daysInPeriod);
+  const difference = toPlan.monthlyCents - fromPlan.monthlyCents;
+  return Math.round((difference * clampedDays) / daysInPeriod);
+}
+
+async function getSubscription(accountId) {
+  const rows = await db.query("SELECT * FROM subscriptions WHERE account_id = $1", [accountId]);
+  if (rows.length === 0) {
+    throw new SubscriptionError(`no subscription for account ${accountId}`);
+  }
+  return rows[0];
+}
+
+async function countSeats(accountId) {
+  const rows = await db.query(
+    "SELECT COUNT(*)::int AS n FROM seats WHERE account_id = $1",
+    [accountId],
+  );
+  return rows[0].n;
+}
+
+async function startTrial(accountId, planId, now = new Date()) {
+  const plan = getPlan(planId);
+  const existing = await db.query("SELECT id FROM subscriptions WHERE account_id = $1", [accountId]);
+  if (existing.length > 0) {
+    throw new SubscriptionError(`account ${accountId} already has a subscription`);
+  }
+  const trialEndsAt = addDays(now, TRIAL_DAYS);
+  const rows = await db.query(
+    `INSERT INTO subscriptions (account_id, plan_id, status, trial_ends_at, current_period_end)
+     VALUES ($1, $2, 'trialing', $3, $3) RETURNING *`,
+    [accountId, planId, trialEndsAt],
+  );
+  await mailer.send(accountId, "trial-started", { plan: plan.name, trialEndsAt });
+  return rows[0];
+}
+
+async function changePlan(accountId, newPlanId, now = new Date()) {
+  const sub = await getSubscription(accountId);
+  const fromPlan = getPlan(sub.plan_id);
+  const toPlan = getPlan(newPlanId);
+  if (sub.plan_id === newPlanId) {
+    return { subscription: sub, chargedCents: 0 };
+  }
+  const seatsInUse = await countSeats(accountId);
+  if (seatsInUse > toPlan.seats) {
+    throw new SubscriptionError(
+      `${toPlan.name} allows ${toPlan.seats} seats; ${seatsInUse} are in use`,
+    );
+  }
+  let chargedCents = 0;
+  if (!isInTrial(sub, now)) {
+    const daysLeft = daysBetween(now, new Date(sub.current_period_end));
+    chargedCents = prorateCents(fromPlan, toPlan, daysLeft, PERIOD_DAYS);
+    if (chargedCents > 0) {
+      await payments.charge(sub.payment_method_id, chargedCents, `plan-change-${sub.id}`);
+    } else if (chargedCents < 0) {
+      await payments.credit(sub.account_id, -chargedCents, `plan-change-${sub.id}`);
+    }
+  }
+  const rows = await db.query(
+    "UPDATE subscriptions SET plan_id = $1 WHERE id = $2 RETURNING *",
+    [newPlanId, sub.id],
+  );
+  return { subscription: rows[0], chargedCents };
+}
+
+async function renew(sub, now = new Date()) {
+  const plan = getPlan(sub.plan_id);
+  const reference = `renewal-${sub.id}-${now.toISOString().slice(0, 10)}`;
+  try {
+    await payments.charge(sub.payment_method_id, plan.monthlyCents, reference);
+  } catch (err) {
+    log.warn("renewal failed", { subscriptionId: sub.id, error: err.message });
+    await db.query(
+      "UPDATE subscriptions SET status = 'past_due', past_due_since = $1 WHERE id = $2",
+      [now, sub.id],
+    );
+    await mailer.send(sub.account_id, "payment-failed", { plan: plan.name });
+    return false;
+  }
+  await db.query(
+    `UPDATE subscriptions
+     SET status = 'active', past_due_since = NULL, current_period_end = $1
+     WHERE id = $2`,
+    [addDays(now, PERIOD_DAYS), sub.id],
+  );
+  return true;
+}
+
+/** Renews every subscription whose period has ended. Resolves once all renewals are done. */
+async function renewDue(now = new Date()) {
+  const due = await db.query(
+    "SELECT * FROM subscriptions WHERE status IN ('active', 'trialing') AND current_period_end <= $1",
+    [now],
+  );
+  let renewed = 0;
+  due.forEach(async (sub) => {
+    if (await renew(sub, now)) {
+      renewed += 1;
+    }
+  });
+  return { due: due.length, renewed };
+}
+
+async function cancel(accountId, { immediately = false } = {}, now = new Date()) {
+  const sub = await getSubscription(accountId);
+  if (sub.status === "cancelled") {
+    return sub;
+  }
+  const endsAt = immediately ? now : new Date(sub.current_period_end);
+  const rows = await db.query(
+    `UPDATE subscriptions SET status = 'cancelled', cancelled_at = $1, ends_at = $2
+     WHERE id = $3 RETURNING *`,
+    [now, endsAt, sub.id],
+  );
+  await mailer.send(accountId, "subscription-cancelled", { endsAt });
+  return rows[0];
+}
+
+async function suspendExpiredGracePeriods(now = new Date()) {
+  const pastDue = await db.query("SELECT * FROM subscriptions WHERE status = 'past_due'", []);
+  const expired = pastDue.filter((sub) => graceExpired(sub, now));
+  for (const sub of expired) {
+    await db.query("UPDATE subscriptions SET status = 'suspended' WHERE id = $1", [sub.id]);
+    await mailer.send(sub.account_id, "subscription-suspended", {});
+  }
+  return expired.length;
+}
+
+function describe(sub, now = new Date()) {
+  const plan = getPlan(sub.plan_id);
+  const price = `${formatPrice(plan.monthlyCents)}/month`;
+  if (isInTrial(sub, now)) {
+    const left = daysBetween(now, new Date(sub.trial_ends_at));
+    return `${plan.name} trial, ${left} day(s) left, then ${price}`;
+  }
+  switch (sub.status) {
+    case "past_due":
+      return `${plan.name}, payment overdue`;
+    case "suspended":
+      return `${plan.name}, suspended until payment`;
+    case "cancelled":
+      return `${plan.name}, cancelled`;
+    default:
+      return `${plan.name}, ${price}`;
+  }
+}
+
+module.exports = {
+  PLANS,
+  SubscriptionError,
+  getPlan,
+  prorateCents,
+  isInTrial,
+  graceExpired,
+  getSubscription,
+  startTrial,
+  changePlan,
+  renew,
+  renewDue,
+  cancel,
+  suspendExpiredGracePeriods,
+  describe,
+};
